# Copy to .env (never committed). Read by scripts/*.py
OPENAI_API_KEY=sk-...
# Run `python scripts/list_models.py` and pick models your key can use.
EXTRACTION_MODEL=gpt-6-luna
EXTRACTION_EFFORT=low
# Cascade: re-read with this model on poor scans / low confidence / rule failures. Empty = off.
ESCALATION_MODEL=gpt-6.1-sol
ESCALATION_EFFORT=medium
RESOLUTION_MODEL=gpt-6-luna
RESOLUTION_EFFORT=low
# Leave empty to use the local in-memory FHIR store. Set to use AWS HealthLake, e.g.
# https://healthlake.us-east-1.amazonaws.com/datastore/<id>/r4/
HEALTHLAKE_ENDPOINT=
AWS_REGION=us-east-1
